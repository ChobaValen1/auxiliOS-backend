PORT=3000
NODE_ENV=development
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
SUPABASE_ANON_KEY=tu-anon-o-publishable-key
OPENAI_API_KEY=tu-openai-key
ALLOWED_ORIGINS=http://localhost:5500,https://auxilios-arg.vercel.app
TRUST_PROXY=false
PASSWORD_RESET_REDIRECT=https://auxilios-arg.vercel.app
JSON_LIMIT=5mb
MAX_UPLOAD_BYTES=8388608
MAX_UPLOAD_FILES=7

# PostgreSQL legado. Si DATABASE_URL/PGHOST no están definidos, estas rutas
# responden 503 y el resto del backend continúa operativo.
# DATABASE_URL=postgresql://usuario:password@host:5432/base
# PGSSL=true
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=sigma_remolques
# PGUSER=postgres
# PGPASSWORD=cambiar
